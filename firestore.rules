rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // 1. Global Matcher — Enables 100% Full Permissions Across All Collections, Subcollections & Paths
    match /{document=**} {
      allow read, write: if true;
    }

    // 2. Explicit Collection Paths
    match /rooms/{id} {
      allow read, write: if true;
    }

    match /categories/{id} {
      allow read, write: if true;
    }

    match /locations/{id} {
      allow read, write: if true;
    }

    match /blogs/{id} {
      allow read, write: if true;
    }

    match /upgrades/{id} {
      allow read, write: if true;
    }

    match /coupons/{id} {
      allow read, write: if true;
    }

    match /reviews/{id} {
      allow read, write: if true;
    }

    match /users/{uid} {
      allow read, write: if true;
    }

    match /bookings/{id} {
      allow read, write: if true;
    }

    match /wishlists/{uid} {
      allow read, write: if true;
    }

    match /notifications/{uid} {
      allow read, write: if true;
    }

    match /chats/{guestUid} {
      allow read, write: if true;
      
      match /messages/{msgId} {
        allow read, write: if true;
      }
    }

    match /newsletter/{id} {
      allow read, write: if true;
    }

    match /newsletters/{id} {
      allow read, write: if true;
    }

    match /subscribers/{id} {
      allow read, write: if true;
    }

    match /broadcasts/{id} {
      allow read, write: if true;
    }
  }
}