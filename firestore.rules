rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Catalog & Content Collections — Public Read, Authenticated Write
    match /rooms/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /locations/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /blogs/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /upgrades/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /coupons/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 2. Reviews — Public Read, Public Create (Guest Reviews), Authenticated Update/Delete
    match /reviews/{id} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 3. Bookings — Public Create (Guest Reservations), Authenticated Read/Update/Delete
    match /bookings/{id} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // 4. User Profiles & Wishlists — Owner & Authenticated Access
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == uid;
      allow create, delete: if false; // Handled exclusively via Serverless Functions using Firebase Admin SDK
    }

    match /email_verifications/{id} {
      allow read, write: if false; // Serverless Admin SDK access only
    }

    match /wishlists/{uid} {
      allow read, write: if isAuthenticated();
    }

    match /notifications/{uid} {
      allow read, write: if isAuthenticated();
    }

    // 5. Live Concierge Guest Chat
    match /chats/{guestUid} {
      allow read, write: if true;
      
      match /messages/{msgId} {
        allow read, write: if true;
      }
    }

    // 6. Subscriptions & Marketing
    match /newsletter/{id} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /newsletters/{id} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /broadcasts/{id} {
      allow read, write: if isAuthenticated();
    }
  }
}