# Kaghan Stay Netlify Serverless Functions Environment Variables Template
# Store real secret values in Netlify Dashboard: Site settings -> Environment variables

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=kaghan-properties
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kaghan-properties.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX...\n-----END PRIVATE KEY-----\n"

# SMTP Email Credentials (booking notifications & customer reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reservations@kphstay.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="KPH Stay Reservations <reservations@kphstay.com>"

# Admin Protection & Internal Tokens
ADMIN_SECRET_KEY=kaghan-admin-secure-auth-token-key

# Groq AI Concierge Integration Key (Optional)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Golootlo Voucher & Discount Integration
GOLOOTLO_USERNAME=your_golootlo_username
GOLOOTLO_PASSWORD=your_golootlo_password
GOLOOTLO_MERCHANT_CODE=1268
GOLOOTLO_API_BASE_URL=https://api-toolkit-staging.golootlo.pk
GOLOOTLO_CHANNEL_ID=01
GOLOOTLO_DEFAULT_COUPON=KPHSTAY1
GOLOOTLO_DISCOUNT_PERCENT=15

